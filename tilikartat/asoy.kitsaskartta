{"asetukset": {"Tilikartta": "Asunto-osakeyhtiö", "TilikarttaPvm": "2024-03-01", "TilikarttaTekija": "autobook@autobook.fi", "VakioTilikartta": "asoy", "KitsasVersio": "5.0", "kielet": {"fi": {"fi": "suomi", "sv": "finska", "en": "Finnish", "ch": "芬兰语"}, "sv": {"fi": "ruotsi", "sv": "svenska", "en": "Swedish", "ch": "瑞典语"}, "zh": {"fi": "kiina", "sv": "kinesiska", "en": "Chinese", "ch": "中文"}}, "kieli": "fi", "tpkieli": "fi", "muodot": {"asoy": {"fi": "Asunto-osakeyhtiö", "sv": "Bostadsaktiebolag", "ch": "住宅股份公司"}}, "laajuudet": {"1": {"fi": "Suppea", "sv": "Kort", "ch": "简版"}, "2": {"fi": "Tavallinen, ei palkkoja", "sv": "Normal, utan löner", "ch": "标准（无工资）"}, "3": {"fi": "Tavallinen, palkat", "sv": "Normal, med löner", "ch": "标准（含工资）"}, "4": {"fi": "Laaja, ei konsernitilejä", "sv": "Omfattande, utan koncernkonton", "ch": "扩展（无合并科目）"}, "5": {"fi": "Kaikki tilit, myös konserni", "sv": "Alla konton, även koncernkonton", "ch": "全部科目（含合并）"}}, "laajuus": "3", "alvlaajuus": "5", "tositesarjat": {"0": "X", "100": "OL", "110": "OL", "120": "KL", "200": "ML", "210": "ML", "214": "ML", "216": "ML", "300": "X", "400": "T", "500": "P", "700": "MT", "800": "LT", "*": "JT", "K": "K"}, "palkkatilit": {"EP": 2986, "SB": 2986, "AY": 2988, "KM": 4741, "PR": 4751, "AT": 4761, "PA": 5000, "LK": 5002, "PI": 5003, "LS": 5004, "LU": 5005, "LV": 5040, "EL": 5100, "SV": 5120, "TV": 5122, "UO": 2989}, "maksutavat+": [{"fi": "Lasku", "sv": "Faktura", "TILI": 1700, "KUVA": "lasku", "ERA": -1, "ch": "发票"}, {"fi": "Käteinen", "sv": "Kontant", "TILI": 1900, "KUVA": "kateinen", "ch": "现金"}, {"fi": "Pankkitili", "sv": "Bankkonto", "TILI": 1910, "KUVA": "pankki", "ch": "银行账户"}, {"fi": "Hyvityslasku", "sv": "Kreditnota", "TILI": 1700, "KUVA": "poista", "ch": "贷项通知单"}, {"fi": "Siirtosaaminen", "sv": "Resultatreglering", "TILI": 1770, "KUVA": "siirra", "ERA": -1, "ch": "应计（递延）应收"}], "maksutavat-": [{"fi": "Lasku", "sv": "Faktura", "TILI": 2960, "KUVA": "lasku", "ERA": -1, "ch": "发票"}, {"fi": "Käteinen", "sv": "Kontant", "TILI": 1900, "KUVA": "kateinen", "ch": "现金"}, {"fi": "Pankkitili", "sv": "Bankkonto", "TILI": 1910, "KUVA": "pankki", "ch": "银行账户"}, {"fi": "Pankkikortti", "sv": "Bankkort", "TILI": 2964, "KUVA": "pankkikortti", "ch": "银行借记卡"}, {"fi": "Luottokortti", "sv": "Kreditkort", "TILI": 2963, "KUVA": "luottokortti", "ch": "信用卡"}, {"fi": "Hyvityslasku", "sv": "Kreditnota", "TILI": 2960, "KUVA": "poista", "ch": "贷项通知单"}, {"fi": "Siirtovelka", "sv": "Resultatreglering", "TILI": 2990, "KUVA": "siirra", "ERA": -1, "ch": "应计（递延）应付"}], "tilinpaatosvalinnat": "toiminnantarkastus", "arkistoraportit": "tase/yleinen,tulos/yleinen", "LaskuSaatavatili": "1700", "LaskuKateistili": "1900", "LaskuKorttitili": "1704", "LaskuMaksuaika": "14", "LaskuSeuraavaId": "1", "LaskuViivakoodi": true, "LaskuIkkunaX": "18", "LaskuIkkunaY": "40", "LaskuIkkunaLeveys": "95", "LaskuIkkunaKorkeus": "35", "LaskuQR": "ON", "LaskuLogoKorkeus": "20", "LogonSijainti": "VIERESSA", "LaskuNumerointialkaa": "1", "LaskuRiviTyyppi": "1", "VariKehys": "128,128,128", "VariVarjo": "230,230,230", "AlvKausi": "1", "AlvHuojennusTili": "3590", "LaskuEnnakkotili": "2950", "LaskuEnnakkosaatavat": "1705", "LaskuEnnakkoALV": "29852", "LaskuMaksumuistutustili": "9070", "LaskuViivastyskorkotili": "9070", "OletusMyyntitili": "3100", "OletusMenotili": "8390", "Yleverotili": "8390", "Tuloveroennakkotili": "7099", "Tuloverojaksotustili": "7099", "Tuloverosiirtovelat": "2990", "Tuloverosiirtosaamiset": "1770", "PankkiPalvelumaksutili": "7021", "TiliotePankkokorttitili": "2964", "TiliotePankkikorttitiliKaytossa": "ON", "PankkiSaapuvakorko": "9070", "PankkiMaksettavakorko": "9170", "VeroOmaverotili": "2986", "AlvVelkatili": "2984", "Ostovelkatili": "2960", "AlvPalautusSaatavatilille": true, "AlvMaksettava": "2982", "AlvPalautettava": "1764", "PalkkaFiTilit": {"2921": 2986, "2925": 2989, "2933": 2989, "5100": 5002, "5110": 5002, "5130": 5000, "5180": 5000, "5200": 5003, "5201": 5003, "5420": 5005, "5400": 5005, "5410": 5005, "5430": 5005, "5440": 5005, "5300": 5004, "5310": 5004, "5340": 5004, "5350": 5004, "6140": 5100, "6420": 5122, "7070": 7690, "7120": 7690, "7860": 7690, "7870": 7690, "7880": 7690, "7890": 7690, "7900": 7690, "7910": 7690, "7920": 5005, "5990": 5040, "5120": 5000}, "Laskuteksti/Saate": {"en": "The attachment contains an invoice for your order.\nPlease pay the invoice no later than the due date.\n\nYou can use the virtual barcode {{virtuaali}} to pay\nInvoice sum {{summa}}\nReference number {{viite}}\nOur account number {{iban}}", "fi": "Liitteessä on lasku tilauksestasi.\nMaksathan laskun viimeistään eräpäivänä.\n\nVoit käyttää maksamiseen virtuaaliviivakoodia {{virtuaali}}\nLaskun summa {{summa}}\nViitenumero {{viite}}\nTilinumeromme {{iban}}", "sv": "Bilagan innehåller en faktura för din beställning.\nBetala fakturan senast på förfallodagen.\n\nDu kan använda den virtuella streckkoden {{virtuaali}} för att betala\nFakturasum {{summa}}\nReferensnummer {{viite}}\nVårt kontonummer {{iban}}", "ch": "附件包含您的订单发票。\n请您最迟于到期日付款。\n\n您可以使用虚拟条码 {{virtuaali}} 进行支付。\n发票金额 {{summa}}\n参考号 {{viite}}\n我们的账户 {{iban}}"}, "Laskuteksti/Saate_otsikko": {"en": "Your invoice", "fi": "Lasku {{numero}}, {{yritys}}", "sv": "Din faktur", "ch": "您的发票"}, "Laskuteksti/Maksumuistutuslisatiedot": {"fi": "Kirjanpitomme mukaan emme ole saaneet maksusuoritustanne. Pyydämme maksuanne alla olevan erittelyn mukaisesti. Mikäli olette jo maksaneet laskun tai lasku on virheellinen, ottakaa yhteyttä asian selvittämiseksi.", "sv": "Enligt våra noteringar är ovanstående fakturor obetalda. Vi ber er betala dem omgående. Om ni har betalt eller om faktura är felig, var vänlig och kontakta oss.", "en": "According to our records, we have not yet received a remittance for above invoice. If you have already sent your payment or there is a mistake in this invoice, please contact us.", "ch": "根据我们的账务记录，尚未收到您的付款。请按照下方明细进行支付。若您已完成付款或发票存在错误，请尽快与我们联系以便核实。"}, "Laskuteksti/Maksumuistutussaate": {"en": "According to our records, we have not received your payment. We request your payment in accordance with the attached payment reminder. If you have already paid the invoice or the invoice is incorrect, please contact us to clarify the matter.", "fi": "Kirjanpitomme mukaan emme ole saaneet maksusuoritustanne. Pyydämme maksuanne liitteenä olevan maksumuistutuksen mukaisesti. Mikäli olette jo maksaneet laskun tai lasku on virheellinen, ottakaa yhteyttä asian selvittämiseksi.", "sv": "Enligt våra uppgifter, vi har inte fått din betalning. Vi begär din betalning i enlighet med bifogad betalningspåminnelse. Om du redan har betalat fakturan eller fakturan är felaktig, vänligen kontakta oss för att klargöra ärendet.", "ch": "根据我们的记录，尚未收到您的付款。请按照随附的付款提醒进行支付。若您已付款或发票有误，请与我们联系以澄清事宜。"}, "Laskuteksti/Maksumuistutussaate_otsikko": {"en": "Payment reminder", "fi": "Maksumuistutus", "sv": "Betalningpåminnelse", "ch": "付款提醒"}, "tulos/yleinen": {"nimi": {"fi": "Tuloslaskelma", "sv": "Resultaträkning", "zh": "利润表"}, "muoto": {"fi": "Asunto-osakeyhtiö", "sv": "Bostadsaktiebolag", "zh": "住宅股份公司"}, "rivit": [{"fi": "Kiinteistön tuotot", "sv": "Intäkter av fastighet", "L": "3", "zh": "房地产收入"}, {"fi": "Vastikkeet", "sv": "Vederlag", "L": "31 *", "S": 1, "zh": "对价"}, {"fi": "Vuokrat", "sv": "Hyror och arrenden", "L": "32 *", "S": 1, "zh": "租金"}, {"fi": "Käyttökorvaukset", "sv": "Serviceintäkter", "L": "33 *", "S": 1, "zh": "使用费用"}, {"fi": "Muut kiinteistön tuotot", "sv": "Övrika intäkter av fastigheten", "L": "35 *", "S": 1, "zh": "其他房地产收入"}, {"fi": "Luottotappiot ja oikaisuerät", "sv": "Kreditförluster och korrektivposter", "L": "39 *", "zh": "信用损失和调整项目"}, {"fi": "Kiinteistön hoitokulut", "sv": "Kostnader för fastighetens skötsel", "L": "5,7,8", "zh": "物业管理费用"}, {"fi": "Henkilöstökulut", "sv": "Personalkostnader", "L": "5 *", "S": 1, "zh": "人力资源成本"}, {"fi": "Hallinto", "sv": "Förvaltning", "L": "70 *", "S": 1, "zh": "管理"}, {"fi": "Käyttö ja huolto", "sv": "Drift och undelhåll", "L": "71 *", "S": 1, "zh":