nkkonto", "TILI": 1910, "KUVA": "pankki", "zh": "银行账户"}, {"fi": "Luottokortti", "sv": "Kreditkort", "TILI": 1711, "KUVA": "luottokortti", "zh": "信用卡"}, {"fi": "Hyvityslasku", "sv": "Kreditnota", "TILI": 1701, "KUVA": "poista", "zh": "贷项通知单"}, {"fi": "Siirtosaaminen", "sv": "Resultatreglering", "TILI": 1849, "KUVA": "siirra", "ERA": -1, "zh": "预提应收（递延支出）"}, {"fi": "Yksityistili", "sv": "Privatkonto", "TILI": 2365, "KUVA": "yksityis", "MUOTO": "tmi", "zh": "业主往来"}], "maksutavat-": [{"fi": "Lasku", "sv": "Faktura", "TILI": 2871, "KUVA": "lasku", "ERA": -1, "zh": "发票"}, {"fi": "Käteinen", "sv": "Kontant", "TILI": 1900, "KUVA": "kateinen", "zh": "现金"}, {"fi": "Pankkitili", "sv": "Bankkonto", "TILI": 1910, "KUVA": "pankki", "zh": "银行账户"}, {"fi": "Pankkikortti", "sv": "Bankkort", "TILI": 2883, "KUVA": "pankkikortti", "zh": "借记卡"}, {"fi": "Luottokortti", "sv": "Kreditkort", "TILI": 2882, "KUVA": "luottokortti", "zh": "信用卡"}, {"fi": "Hyvityslasku", "sv": "Kreditnota", "TILI": 2871, "KUVA": "poista", "zh": "贷项通知单"}, {"fi": "Siirtovelka", "sv": "Resultatreglering", "TILI": 2979, "KUVA": "siirra", "ERA": -1, "zh": "预提应付（递延收入）"}, {"fi": "Yksityistili", "sv": "Privatkonto", "TILI": 2361, "KUVA": "yksityis", "MUOTO": "tmi", "zh": "业主往来"}], "LaskuTilit": "1910", "tilinpaatosvalinnat": "", "arkistoraportit": "tase/yleinen,tulos/yleinen", "LaskuSaatavatili": "1701", "LaskuKateistili": "1900", "LaskuKorttitili": "1711", "LaskuMaksuaika": "14", "LaskuHuomautusaika": "8", "LaskuPeruskorko": "0", "LaskuNumerointialkaa": "1", "LaskuRiviTyyppi": "2", "LaskuSeuraavaId": "1", "LaskuMaksumuistutustili": "9170", "LaskuViivastyskorkotili": "9170", "LaskuViivakoodi": true, "LaskuIkkunaX": "18", "LaskuIkkunaY": "40", "LaskuIkkunaLeveys": "95", "LaskuIkkunaKorkeus": "35", "LaskuQR": true, "LaskuLogoKorkeus": "20", "LogonSijainti": "VIERESSA", "VariKehys": "128,128,128", "VariVarjo": "230,230,230", "AlvKausi": "1", "AlvHuojennusTili": "3840", "LaskuEnnakkotili": "2861", "LaskuEnnakkosaatavat": "1715", "LaskuEnnakkoALV": "29392", "OletusMyyntitili": "3000", "OletusMenotili": "4000", "Yleverotili": "8740", "Tuloveroennakkotili": "9900", "Tuloverojaksotustili": "9940", "Tuloverosiirtovelat": "2968", "Tuloverosiirtosaamiset": "1813", "PankkiPalvelumaksutili": "8560", "PankkiSaapuvakorko": "9220", "PankkiMaksettavakorko": "9460", "TiliotePankkikorttitili": "2883", "TiliotePankkikorttitiliKaytossa": "ON", "VeroOmaverotili": "2920", "Ostovelkatili": "2871", "AlvVelkatili": "2939", "AlvPalautusSaatavatilille": true, "AlvMaksettava": "2922", "AlvPalautettava": "1762", "Yksityistilit/Peruspaaoma": "2201", "Laskuteksti/Saate": {"en": "The attachment contains an invoice for your order.\nPlease pay the invoice no later than the due date.\n\nYou can use the virtual barcode {{virtuaali}} to pay\nInvoice sum {{summa}}\nReference number {{viite}}\nOur account number {{iban}}", "fi": "Liitteessä on lasku tilauksestasi.\nMaksathan laskun viimeistään eräpäivänä.\n\nVoit käyttää maksamiseen virtuaaliviivakoodia {{virtuaali}}\nLaskun summa {{summa}}\nViitenumero {{viite}}\nTilinumeromme {{iban}}", "sv": "Bilagan innehåller en faktura för din beställning.\nBetala fakturan senast på förfallodagen.\n\nDu kan använda den virtuella streckkoden {{virtuaali}} för att betala\nFakturasum {{summa}}\nReferensnummer {{viite}}\nVårt kontonummer {{iban}}", "zh": "附件包含您的订单发票。\n请在到期日前完成付款。\n\n您可以使用虚拟条码 {{virtuaali}} 进行支付。\n发票金额 {{summa}}\n参考号 {{viite}}\n我们的账户 {{iban}}"}, "Laskuteksti/Saate_otsikko": {"en": "Your invoice", "fi": "Lasku {{numero}}, {{yritys}}", "sv": "Din faktur", "zh": "您的发票"}, "Laskuteksti/Maksumuistutuslisatiedot": {"fi": "Kirjanpitomme mukaan emme ole saaneet maksusuoritustanne. Pyydämme maksuanne alla olevan erittelyn mukaisesti. Mikäli olette jo maksaneet laskun tai lasku on virheellinen, ottakaa yhteyttä asian selvittämiseksi.", "sv": "Enligt våra noteringar är ovanstående fakturor obetalda. Vi ber er betala dem omgående. Om ni har betalt eller om faktura är felig, var vänlig och kontakta oss.", "en": "According to our records, we have not yet received a remittance for above invoice. If you have already sent your payment or there is a mistake in this invoice, please contact us.", "zh": "根据我们的账务记录，尚未收到您的付款。请按照下方明细进行支付。若您已完成付款或发票有误，请及时与我们联系以便核实。"}, "Laskuteksti/Maksumuistutussaate": {"en": "According to our records, we have not received your payment. We request your payment in accordance with the attached payment reminder. If you have already paid the invoice or the invoice is incorrect, please contact us to clarify the matter.", "fi": "Kirjanpitomme mukaan emme ole saaneet maksusuoritustanne. Pyydämme maksuanne liitteenä olevan maksumuistutuksen mukaisesti. Mikäli olette jo maksaneet laskun tai lasku on virheellinen, ottakaa yhteyttä asian selvittämiseksi.", "sv": "Enligt våra uppgifter, vi har inte fått din betalning. Vi begär din betalning i enlighet med bifogad betalningspåminnelse. Om du redan har betalat fakturan eller fakturan är felaktig, vänligen kontakta oss för att klargöra ärendet.", "zh": "根据我们的记录，尚未收到您的付款。请按随附的付款提醒完成支付。若您已付款或发票有误，请与我们联系以澄清。"}, "Laskuteksti/Maksumuistutussaate_otsikko": {"en": "Payment reminder", "fi": "Maksumuistutus", "sv": "Betalningpåminnelse", "zh": "付款提醒"}, "tulos/yleinen": {"nimi": {"fi": "Tuloslaskelma", "sv": "Resultaträkning", "en": "Profit and loss account", "zh": "利润表"}, "muoto": {"fi": "Yleinen", "sv": "Allmän", "en": "General", "zh": "通用"}, "rivit": [{"fi": "Liikevaihto", "sv": "Omsättning", "en": "Net turnover", "M": "bold", "L": "30..35 S *", "zh": "营业收入"}, {"fi": "Valmiiden ja keskeneräisten tuotteiden varastojen muutos", "sv": "Förändring av lager av färdiga varor och varor under tillverkning", "en": "Variation in stocks of finished goods and in work in progress", "L": "360..362 *", "V": 1, "zh": "产成品与在产品存货变动"}, {"fi": "Valmistus omaan käyttöön", "sv": "Tillverkning för eget bruk", "en": "Work performed by the undertaking for its own purpose and capitalised", "L": "363..364 *", "zh": "自制资产资